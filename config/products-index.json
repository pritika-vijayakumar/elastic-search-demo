{
  "settings": {"index": {"mode": "vectordb_document"}},
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "product_id": {"type": "keyword"},
      "name": {"type": "text", "fields": {"exact": {"type": "keyword"}}},
      "brand": {"type": "text"},
      "category": {"type": "keyword"},
      "description": {"type": "text"},
      "product_guide": {"type": "text"},
      "searchable_content": {"type": "semantic_text", "inference_id": "__INFERENCE_ID__"},
      "price": {"type": "scaled_float", "scaling_factor": 100},
      "currency": {"type": "keyword"},
      "attributes": {"properties": {"waterproof": {"type": "boolean"}}},
      "variants": {
        "type": "nested",
        "properties": {
          "size_system": {"type": "keyword"},
          "size": {"type": "keyword"},
          "stock": {"type": "integer"}
        }
      }
    }
  }
}

